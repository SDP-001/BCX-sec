{
  "buildCommand": "cd SecurePatch-AI/frontend && npm install && npm run build",
  "outputDirectory": "SecurePatch-AI/frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/proxy?__proxy_path=v1/:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
